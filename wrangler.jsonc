{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "parter-event-scraper",
  "main": "worker/index.js",
  "compatibility_date": "2026-07-02",
  "vars": {
    "ECOSYSTEM_BASE_URL": "https://soqnh-online.randall-d53.workers.dev"
  },
  "secrets": {
    "required": ["SCRAPER_API_TOKEN", "SCRAPER_ADMIN_TOKEN"]
  },
  "services": [
    {
      "binding": "SOQNH_ONLINE",
      "service": "soqnh-online"
    }
  ],
  "triggers": {
    "crons": ["0 13 * * *"]
  }
}
